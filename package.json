{
  "name": "chat-app",
  "version": "1.0.0",
  "description": "Real-time chat application",
  "type": "module",
  "scripts": {
    "client": "cd client && npm run dev",
    "server": "cd server && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "concurrently": "^7.6.0",
    "tailwindcss": "^4.3.0"
  }
}
